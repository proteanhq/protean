# Alembic configuration for the migrations of one Protean provider.

[alembic]
script_location = %(here)s
path_separator = os

# The domain and the provider these migrations belong to. Protean's commands
# take the domain from --domain; a plain `alembic` run reads it from here. A
# relative domain path is resolved from the directory `alembic` runs in.
protean_domain = $domain
protean_provider = $provider

[loggers]
keys = root,sqlalchemy,alembic

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = WARNING
handlers = console
qualname =

[logger_sqlalchemy]
level = WARNING
handlers =
qualname = sqlalchemy.engine

[logger_alembic]
level = INFO
handlers =
qualname = alembic

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(levelname)-5.5s [%(name)s] %(message)s
datefmt = %H:%M:%S
