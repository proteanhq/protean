"""Shared value objects used across multiple aggregates."""

from decimal import Decimal
from typing import Annotated

from protean import invariant
from protean.exceptions import ValidationError
from pydantic import Field

from {{ package_name }}.domain import {{ domain_name }}


@{{ domain_name }}.value_object
class Money:
    """Value object representing monetary values."""

    amount: Decimal
    currency: Annotated[str, Field(max_length=3)] | None = "USD"

    def add(self, other: "Money") -> "Money":
        """Add two money values."""
        if self.currency != other.currency:
            raise ValidationError({"currency": ["Cannot add money with different currencies"]})
        return Money(amount=self.amount + other.amount, currency=self.currency)

    def subtract(self, other: "Money") -> "Money":
        """Subtract money values."""
        if self.currency != other.currency:
            raise ValidationError({"currency": ["Cannot subtract money with different currencies"]})
        return Money(amount=self.amount - other.amount, currency=self.currency)


@{{ domain_name }}.value_object
class EmailAddress:
    """Value object for email addresses."""

    email: Annotated[str, Field(max_length=254)]

    @invariant.post
    def email_must_contain_at_sign(self):
        if "@" not in self.email:
            raise ValidationError({"email": [f"Invalid email address: {self.email}"]})
