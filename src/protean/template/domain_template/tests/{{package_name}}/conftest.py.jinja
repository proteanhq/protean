from pathlib import Path

import pytest
from protean.integrations.pytest import DomainFixture


def pytest_collection_modifyitems(config, items):
    """Automatically mark tests based on their directory location."""
    for item in items:
        # Get the test file path relative to the tests directory
        test_path = Path(item.fspath)

        # Mark tests based on their directory
        if "/domain/" in str(test_path):
            item.add_marker(pytest.mark.domain)
        elif "/application/" in str(test_path):
            item.add_marker(pytest.mark.application)
        elif "/integration/" in str(test_path):
            item.add_marker(pytest.mark.integration)
            # Integration tests are often slower
            if not any(m.name == "fast" for m in item.iter_markers()):
                item.add_marker(pytest.mark.slow)


@pytest.fixture(scope="session", autouse=True)
def domain_fixture():
    """Set up the domain once for the whole session, and drop its schema at the end.

    This is a session-scoped autouse fixture, not ``pytest_sessionstart``, on
    purpose. ``pytest_sessionstart`` in a nested ``conftest.py`` only fires when
    the collection path passes through this directory, so a plain ``pytest`` or
    ``make test`` (both driven by ``testpaths = ["tests"]``) would never run it
    and every test would fail with "no domain context". An autouse fixture runs
    for any invocation that collects a test under this package.

    ``DomainFixture.setup()`` initialises the domain and creates the database
    tables, so a project scaffolded with any database choice runs its tests on
    the first try. ``teardown()`` drops them again.

    The domain loads its config when it is constructed. Protean's pytest plugin
    defaults ``PROTEAN_ENV`` to ``test`` before collection (without overriding
    an already-set value), so the domain module reads the right config when it
    is imported.
    """
    from {{ package_name }}.domain import {{ domain_name }} as domain

    fixture = DomainFixture(domain)
    fixture.setup()
    yield fixture
    fixture.teardown()


@pytest.fixture(autouse=True)
def _domain_context(domain_fixture):
    """Run each test in a fresh domain context, and reset all data after it."""
    with domain_fixture.domain_context():
        yield
