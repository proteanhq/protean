# Copy to `.env` and source it (or export the values) to run the app against
# the PostgreSQL + Redis services in docker-compose.yml instead of the default
# SQLite + inline broker.
#
#   cp .env.example .env
#   docker compose up -d   # older Docker: docker-compose up -d
#   set -a && . ./.env && set +a
#   uvicorn app.api:app
#
# Leave these unset for the clean-clone path: domain.toml falls back to SQLite
# and the inline broker.

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://protean:protean@localhost:5432/reference_app

BROKER_PROVIDER=redis
BROKER_URL=redis://localhost:6379/0
